{
  "schema": 2,
  "deck": {
    "main": {
      "minimum": 40,
      "maximum": 80,
      "copy_limit": 3,
      "legendary_copy_limit": 1,
      "reconciliation": "GDD clause 11 defines the Main Deck as 40-80 cards. The later phrase up to 40 is recorded as a request for a 40-card target, not a replacement of the explicit 40-80 GDD range; legality therefore keeps the authoritative 40-80 range."
    },
    "fusion_extra": {
      "minimum": 0,
      "maximum": 15,
      "allowed_kinds": [
        "fusion"
      ],
      "collection_label": "Fusion/Extra",
      "draws": false,
      "research_basis": "The official contemporary rulebook reference used for this project specifies an Extra Deck maximum of 15 and treats Fusion Monsters as a separate collection. This is a researched project choice, not a claim that the historic Power of Chaos executable enforced this exact cap."
    }
  },
  "legendary": {
    "registry_type": "legendary",
    "required_stars": 11,
    "copy_limit": 1,
    "minimum_effects": 1,
    "maximum_effects": 5,
    "unique_registry_ids": true,
    "requires_special_procedure": true,
    "non_removable_default": false,
    "allowed_deck_collections": [
      "main_cards"
    ],
    "no_other_legendary_deck_rule": false
  },
  "progression": {
    "min_level": 0,
    "max_level": 10,
    "deck_thresholds": [
      0.0,
      0.9,
      1.8,
      2.7,
      3.6,
      4.5,
      5.4,
      6.3,
      7.2,
      8.1,
      9.0
    ],
    "character_wins_per_level": 3,
    "character_losses_per_level": 4,
    "team_wins_per_level": 3,
    "team_losses_per_level": 4,
    "strong_opponent_bonus": 1.0,
    "principle": "Character, deck, and team levels use a visible 0-10 scale. Zero is the valid baseline for an untrained or empty profile; authored stars and deck strength provide the starting value, while results, strong-opponent victories, losses, team history, and locked effects change the calculated value. Each adjacent deck threshold is intentionally separated so a level change represents a measurable strength difference. Championship hosts need five legal 50-card Main Decks and one hundred library cards per championship level."
  },
  "narrator": {
    "idle_seconds": {
      "character": 30.0,
      "duel": 45.0
    },
    "cadence": "repeat after each threshold while no meaningful action observation occurs",
    "background_rendering": false,
    "championship_profiles": {
      "levels": {
        "1": {"tiers": {"4": {"audio_root": "audio/championship/level-1/tier-4"}}},
        "2": {"tiers": {"8": {"audio_root": "audio/championship/level-2/tier-8"}}},
